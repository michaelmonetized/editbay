#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
case "${1-}" in
  new|info|rename|apply|migrate|frame-plan|probe-media|ingest|decode-frame|export|checkpoint|recoveries|recover|--help|-h|--version|-V)
    exec cargo run --quiet --locked --manifest-path "$ROOT/Cargo.toml" --package editbay-cli -- "$@"
    ;;
  *)
    exec cargo run --quiet --locked --manifest-path "$ROOT/Cargo.toml" --package editbay-app --bin editbay-studio -- "$@"
    ;;
esac
